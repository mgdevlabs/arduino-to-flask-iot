# Serial port of the Arduino board on the host (also mapped into the container).
# Examples: /dev/ttyUSB0, /dev/ttyACM0
ARDUINO_PORT=/dev/ttyUSB0

# Optional: SQLite history file location.
# Default: Flask/data/history.db locally, /app/data/history.db in Docker.
# HISTORY_DB_PATH=/app/data/history.db
